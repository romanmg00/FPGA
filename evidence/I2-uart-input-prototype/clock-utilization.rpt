# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y17 [get_cells u_pix_clock/inst/clkf_buf]
set_property LOC BUFGCTRL_X0Y16 [get_cells u_pix_clock/inst/clkout1_buf]
set_property LOC BUFGCTRL_X0Y2 [get_cells u_game_clock/inst/clkf_buf]
set_property LOC BUFGCTRL_X0Y1 [get_cells u_game_clock/inst/clkout1_buf]
set_property LOC BUFGCTRL_X0Y0 [get_cells u_game_buf]

# Location of IO Primitives which is load of clock spine

# Location of clock ports
set_property LOC IOB_X1Y126 [get_ports clk]

# Clock net "u_pix_clock/inst/clk_out1" driven by instance "u_pix_clock/inst/clkout1_buf" located at site "BUFGCTRL_X0Y16"
#startgroup
create_pblock {CLKAG_u_pix_clock/inst/clk_out1}
add_cells_to_pblock [get_pblocks  {CLKAG_u_pix_clock/inst/clk_out1}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="u_pix_clock/inst/clk_out1"}]]]
resize_pblock [get_pblocks {CLKAG_u_pix_clock/inst/clk_out1}] -add {CLOCKREGION_X0Y1:CLOCKREGION_X0Y1}
#endgroup

# Clock net "u_game_clock/inst/clk_out1" driven by instance "u_game_clock/inst/clkout1_buf" located at site "BUFGCTRL_X0Y1"
#startgroup
create_pblock {CLKAG_u_game_clock/inst/clk_out1}
add_cells_to_pblock [get_pblocks  {CLKAG_u_game_clock/inst/clk_out1}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="u_game_clock/inst/clk_out1"}]]]
resize_pblock [get_pblocks {CLKAG_u_game_clock/inst/clk_out1}] -add {CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X1Y1:CLOCKREGION_X1Y1}
#endgroup

# Clock net "clk_game" driven by instance "u_game_buf" located at site "BUFGCTRL_X0Y0"
