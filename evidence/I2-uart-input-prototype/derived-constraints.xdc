# User Generated XDC timing constraints 

create_generated_clock -name game_clk -source [get_pins -of_objects [get_cells game_toggle_reg] -filter {REF_PIN_NAME == C}] -divide_by 83334 [get_pins -of_objects [get_cells u_game_buf] -filter {REF_PIN_NAME == O}]
set_max_delay -datapath_only -from [get_cells [list {u_path/u_fifo/wr_gray_reg[0]} {u_path/u_fifo/wr_gray_reg[1]} {u_path/u_fifo/wr_gray_reg[2]} {u_path/u_fifo/wr_gray_reg[3]} {u_path/u_fifo/wr_gray_reg[4]} {u_path/u_fifo/wr_gray_reg[5]} {u_path/u_fifo/wr_gray_reg[6]}]] -to [get_cells -hier -regexp {.*u_fifo/wr_gray_sync1_reg\[[0-9]+\]}] 11.982
set_bus_skew -from [get_cells [list {u_path/u_fifo/wr_gray_reg[0]} {u_path/u_fifo/wr_gray_reg[1]} {u_path/u_fifo/wr_gray_reg[2]} {u_path/u_fifo/wr_gray_reg[3]} {u_path/u_fifo/wr_gray_reg[4]} {u_path/u_fifo/wr_gray_reg[5]} {u_path/u_fifo/wr_gray_reg[6]}]] -to [get_cells -hier -regexp {.*u_fifo/wr_gray_sync1_reg\[[0-9]+\]}] 11.982
set_max_delay -datapath_only -from [get_cells [list {u_path/u_fifo/rd_gray_reg[0]} {u_path/u_fifo/rd_gray_reg[1]} {u_path/u_fifo/rd_gray_reg[2]} {u_path/u_fifo/rd_gray_reg[3]} {u_path/u_fifo/rd_gray_reg[4]} {u_path/u_fifo/rd_gray_reg[5]} {u_path/u_fifo/rd_bin_reg[6]}]] -to [get_cells -hier -regexp {.*u_fifo/rd_gray_sync1_reg\[[0-9]+\]}] 11.982
set_bus_skew -from [get_cells [list {u_path/u_fifo/rd_gray_reg[0]} {u_path/u_fifo/rd_gray_reg[1]} {u_path/u_fifo/rd_gray_reg[2]} {u_path/u_fifo/rd_gray_reg[3]} {u_path/u_fifo/rd_gray_reg[4]} {u_path/u_fifo/rd_gray_reg[5]} {u_path/u_fifo/rd_bin_reg[6]}]] -to [get_cells -hier -regexp {.*u_fifo/rd_gray_sync1_reg\[[0-9]+\]}] 11.982
set_false_path -from [get_cells -hier -filter {NAME =~ */u_fifo/rd_up_reg}] -to [get_cells -hier -filter {NAME =~ */u_fifo/rd_up_sync1_reg}]
set_false_path -from [get_cells -hier -filter {NAME =~ */u_fifo/wr_up_reg}] -to [get_cells -hier -filter {NAME =~ */u_fifo/wr_up_sync1_reg}]
set_false_path -from [get_ports uart_rx_pin] -to [get_cells -hier -filter {NAME == u_path/u_rx_sync/stage1_reg}]
set_false_path -from [get_ports cpu_resetn] -to [get_cells -hier -filter {NAME == u_button_sync/stage1_reg}]
set_false_path -from [get_cells reset_hold_reg] -to [get_cells u_reset_pix/stage1_reg]
set_false_path -from [get_cells reset_hold_reg] -to [get_cells u_reset_game/stage1_reg]
set_max_delay -datapath_only -from [get_pins [list u_path/u_fifo/memory_reg_0_63_0_2/RAMA/CLK u_path/u_fifo/memory_reg_0_63_0_2/RAMB/CLK u_path/u_fifo/memory_reg_0_63_0_2/RAMC/CLK]] -to [get_cells -hier -regexp {.*u_fifo/rd_data_reg\[[0-9]+\]}] 11.982

